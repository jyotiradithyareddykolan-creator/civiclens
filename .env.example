# Copy to .env (or export in your shell). Names only: never commit real secrets.

# Optional. Without a key the app runs in DEMO / extractive mode (no AI text generation).
ANTHROPIC_API_KEY=
# Or use Google Gemini instead (set only one key, or set CIVICLENS_LLM_PROVIDER=gemini|anthropic):
GEMINI_API_KEY=
# CIVICLENS_LLM_PROVIDER=
# Optional model override (leave unset to use the default for the chosen provider):
# CIVICLENS_LLM_MODEL=

# Path to the scheme dataset (defaults to backend/data/schemes.json).
CIVICLENS_DATA_PATH=

# Set to 1 to allow live fetches of approved *.gov.in / *.nic.in source URLs
# when a source check is requested. Default 0 (offline demo).
CIVICLENS_LIVE_FETCH=0

# Days after which a source's "last checked" date is flagged as stale.
CIVICLENS_STALE_DAYS=90

# Max requests per minute per client IP.
CIVICLENS_RATE_LIMIT_PER_MINUTE=120

# Max upload size (bytes) for /api/documents/inspect.
CIVICLENS_MAX_UPLOAD_BYTES=2000000

# Optional fixed "today" (YYYY-MM-DD) for reproducible demos and tests.
CIVICLENS_TODAY=
